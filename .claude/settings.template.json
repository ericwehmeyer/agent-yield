{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_YIELD}} resume --hook --probe",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "{{AGENT_YIELD}} ingest --changed-only --quiet",
            "timeout": 60,
            "statusMessage": "Catching the corpus up"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_YIELD}} gate --enforce-brief",
            "timeout": 15,
            "statusMessage": "Pricing the dispatch"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_YIELD}} guard",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{AGENT_YIELD}} boundary --enforce",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
